# Copie para `.env.local` e preencha. `.env.local` está no .gitignore.
#
# Onde achar: painel do Supabase > Project Settings > API.

# Públicas — vão para o bundle do browser. Seguras: a anon key só alcança o que
# as policies de RLS permitirem (RN-93).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PRIVADA — bypassa RLS inteiro.
# Nunca prefixar com NEXT_PUBLIC_. Nunca usar em Client Component.
# Uso restrito a código server-side e Edge Functions (Requisito de Segurança 3).
SUPABASE_SERVICE_ROLE_KEY=
